 if mode!='no_binary':
  (out/(name+'_atonbuf.xSPI2.raw')).write_bytes(b'toy weights' if mode!='empty_binary' else b'')
 if mode=='symlink': (out/'foreign').symlink_to('/home/thc1006/dev/SpikeIDS-MCU/tools/n6_deployment/.toy_02/test_publication_endpoint_extr0/repo/source.py')
